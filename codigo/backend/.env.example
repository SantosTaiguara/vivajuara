# Copy to .env (never commit .env). All values below are examples for local development.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# postgres://USER:PASSWORD@HOST:PORT/DB  — in staging/production inject from the secret manager
DATABASE_URL=postgres://postgres@127.0.0.1:5432/plat_dev
DB_POOL_MAX=10
DB_SSL=false
DB_STATEMENT_TIMEOUT_MS=10000
# Comma-separated allowlist of frontend origins (never "*" in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT_BYTES=16384
COMPRESSION=true
TRUST_PROXY=false
# Admin / write routes (PATCH availability, POST price-tables, POST analysis/preview).
# Writes are OFF while ADMIN_API_TOKEN is empty (403 WRITES_DISABLED). Generate a long random value
# (e.g. `openssl rand -hex 32`, at least 32 characters in production) and inject it from the secret manager.
# Never commit a real token; never put it in the frontend.
ADMIN_API_TOKEN=
# Optional kill switch: WRITES_ENABLED=false disables writes even with ADMIN_API_TOKEN set.
# Legacy (deprecated): WRITES_ENABLED=true + WRITE_API_KEY=... is still accepted as a second bearer credential.
# WRITES_ENABLED=
# WRITE_API_KEY=
# Scoped user tokens (topic 30, DevTokenProvider): LOCAL/TEST ONLY, refused in production. Tokens are issued with
# `npm run iam -- create-user ...`; only their sha256 is stored. The real identity provider is a pending decision.
# AUTH_DEV_TOKENS=false
# AUTH_DEV_TOKEN_TTL_SECONDS=2592000
# ---- Login com Google (OIDC + sessão por cookie, fase W3). Organização: org_house7. Guia: docs/AUTH_GOOGLE_OIDC.md
# Login fica DESLIGADO enquanto GOOGLE_CLIENT_ID estiver vazio. Ligado, TODOS os valores abaixo são obrigatórios (o
# servidor não sobe se faltar algum). Os valores reais são SEGREDOS: defina-os como variáveis de ambiente no servidor
# (painel do host / gerenciador de segredos), nunca neste arquivo commitado, em chat ou no frontend.
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=            (segredo do cliente OAuth: só no ambiente do servidor)
# URL de retorno exatamente como cadastrada no Google Cloud Console (https em produção):
AUTH_REDIRECT_URL=
# 32+ caracteres aleatórios (ex.: `openssl rand -base64 48`); trocar invalida todas as sessões e logins em andamento:
# SESSION_SECRET=
# Endereço do painel para onde o navegador volta depois do login (também aceito: origens de CORS_ORIGINS):
AUTH_APP_URL=
# Domínio(s) Google Workspace permitidos (claim hd), separados por vírgula. Vazio = qualquer conta Google verificada
# (contas @gmail.com não têm hd: com ALLOWED_HD definido elas são recusadas).
ALLOWED_HD=
# Domínio pai do cookie quando painel e API ficam em subdomínios (ex.: .house7.com.br). Vazio = cookie __Host- da API.
COOKIE_DOMAIN=
# Sessão: inatividade e duração máxima (segundos). Padrões: 2 h e 12 h.
# AUTH_SESSION_IDLE_SECONDS=7200
# AUTH_SESSION_ABSOLUTE_SECONDS=43200
# Somente desenvolvimento local em http://: AUTH_COOKIE_SECURE=false (recusado em produção)
# AUTH_COOKIE_SECURE=true
# Larger body limit for admin routes (per-lot price tables, methodology configs)
ADMIN_BODY_LIMIT_BYTES=262144
# Idempotency-Key retention in seconds (default 24 h)
IDEMPOTENCY_TTL_SECONDS=86400
# Availability change stream (SSE): heartbeat, safety poll next to LISTEN/NOTIFY (0 = off), connection cap
SSE_HEARTBEAT_MS=15000
SSE_POLL_INTERVAL_MS=5000
SSE_MAX_CLIENTS=200
# Public base URL of the object storage / CDN that serves assets (empty = frontend keeps its local files)
ASSET_BASE_URL=
# Path to the shared domain modules (plat/src). Default: ../src relative to backend/
SHARED_SRC_DIR=
# Path to the methodology configs (plat/config, scoring/<development>/*.json). Default: ../config next to SHARED_SRC_DIR
SHARED_CONFIG_DIR=
LOG_LEVEL=info

# --- Rodada 5 (tópicos 57-63): módulos atrás de flags, TODOS DESLIGADOS por padrão (docs/RELATORIO_LIGACAO_ROTAS_57_63.md).
# Ligado = rotas existem; permissões só do papel OWNER_ADMIN (decisão 2026-10-18); políticas nulas continuam recusando.
# FEATURE_DEALS=0
# FEATURE_ONBOARDING=0
# FEATURE_PRIVACY=0
# FEATURE_BACKOFFICE=0
# FEATURE_DATA_QUALITY=0
# FEATURE_SURROUNDINGS=0
# DEALS_EXPIRY_INTERVAL_MS=60000        # varredura de expiração (relógio do servidor), só com FEATURE_DEALS=1; 0 = não agenda
# IAM_ROLE_GRANTS_FILE=config/iam/role-grants.json
# Entorno (FEATURE_SURROUNDINGS): só nomes, nunca valores versionados
# GOOGLE_MAPS_API_KEY=<cole aqui>
# GOOGLE_MAPS_BROWSER_KEY=<cole aqui>
