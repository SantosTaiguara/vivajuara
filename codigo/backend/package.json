{
  "name": "plat-backend",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "V2 backend (modular monolith) for the lot commercial intelligence platform",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:check": "node scripts/migrate.js check",
    "import": "node scripts/import.js",
    "import:dry-run": "node scripts/import.js --dry-run",
    "shadow-compare": "node scripts/shadow-compare.js",
    "test": "node --test '../tests/backend/*.test.js' 'tests/*.test.js'",
    "openapi": "node scripts/openapi.js",
    "iam": "node scripts/iam.js",
    "openapi:check": "node scripts/openapi.js --check"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
