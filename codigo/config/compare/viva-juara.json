  "developmentId": "viva-juara",
  "evaluationPolicyVersion": "1.0.0",
  "changeReason": "Tópico 25: primeira versão. Semântica conservadora: só critérios com direção formal na metodologia vigente (preço de tabela, scores 0–100, notas de silêncio/privacidade, classe A+–D e Fit com cliente) têm destaque sem contexto. Distâncias, área, sol, trânsito, esquina e área verde dependem do perfil do cliente.",
  "comparisonPolicy": {
    "minCandidates": 2, "maxCandidates": 4, "requireSameDevelopment": true, "allowSold": true, "allowUnavailable": true,
    "allowUnknownAvailability": true, "allowStaleCommercial": true, "preserveCandidateOnStatusChange": true,
    "defaultMetricProfileId": "BROKER_STANDARD", "version": "1.0.0"
  },
  "tiePolicies": {
    "exact": { "type": "EXACT", "version": "1.0.0" },
    "money": { "type": "ABSOLUTE_TOLERANCE", "absoluteTolerance": 0.01, "version": "1.0.0" },
    "score100": { "type": "ABSOLUTE_TOLERANCE", "absoluteTolerance": 1, "version": "1.0.0" },
    "note10": { "type": "ABSOLUTE_TOLERANCE", "absoluteTolerance": 0.1, "version": "1.0.0" },
    "area": { "type": "RELATIVE_TOLERANCE", "relativeTolerancePct": 1, "version": "1.0.0" },
    "distance": { "type": "ABSOLUTE_OR_RELATIVE", "absoluteTolerance": 10, "relativeTolerancePct": 3, "version": "1.0.0" },
    "ordinal": { "type": "EXACT", "enumEqualityRequired": true, "version": "1.0.0" },
    "target": { "type": "TARGET_DISTANCE", "targetDistanceTolerance": 1, "version": "1.0.0" }
  },
  "marginPolicies": {
    "money": { "minimumRelativeDifferencePct": 2, "resultBelowThreshold": "NO_CLEAR_WINNER", "version": "1.0.0" },
    "score100": { "minimumAbsoluteDifference": 3, "resultBelowThreshold": "NO_CLEAR_WINNER", "version": "1.0.0" },
    "note10": { "minimumAbsoluteDifference": 0.5, "resultBelowThreshold": "NO_CLEAR_WINNER", "version": "1.0.0" },
    "area": { "minimumRelativeDifferencePct": 5, "resultBelowThreshold": "NO_CLEAR_WINNER", "version": "1.0.0" },
    "distance": { "minimumAbsoluteDifference": 50, "minimumRelativeDifferencePct": 10, "resultBelowThreshold": "NO_CLEAR_WINNER", "version": "1.0.0" },
    "ordinal": { "minimumOrdinalStep": 1, "resultBelowThreshold": "TIE", "version": "1.0.0" },
    "target": { "targetDistanceDifference": 10, "resultBelowThreshold": "NO_CLEAR_WINNER", "version": "1.0.0" }
  },
  "dataSufficiencyPolicies": {
