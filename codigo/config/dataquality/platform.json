  "glossary": [
    {
      "term": "Disponível",
      "code": "AVAILABLE",
      "definition": "Status comercial confirmado pela fonte de autoridade de disponibilidade. Nunca inferido; UNKNOWN nunca é disponível.",
      "fieldKeys": [
        "availability.status"
      ]
    },
    {
      "term": "Reservado",
      "code": "RESERVED",
      "definition": "Lote com reserva ativa registrada pela fonte de autoridade.",
      "fieldKeys": [
        "availability.status",
        "availability.reservedUntil"
      ]
    },
    {
      "term": "Proposta",
      "code": "PROPOSAL",
      "definition": "Lote com proposta em análise; por política padrão não conta como ofertável.",
      "fieldKeys": [
        "availability.status"
      ]
    },
    {
      "term": "Vendido",
      "code": "SOLD",
      "definition": "Lote vendido; não reabre por padrão (allowSoldReopen=false).",
      "fieldKeys": [
        "availability.status"
      ]
    },
    {
      "term": "Não confirmado",
      "code": "UNKNOWN",
      "definition": "Sem informação da fonte de autoridade. Não é disponível nem indisponível.",
      "fieldKeys": [
        "availability.status"
      ]
    },
    {
      "term": "Aderência (fit)",
      "code": "FIT",
      "definition": "Quanto um lote atende ao perfil de um cliente (tópico 15). Não é qualidade do dado.",
      "fieldKeys": []
    },
    {
      "term": "Confiança",
      "code": "CONFIDENCE",
      "definition": "Confiança do dado/estimativa (tópico 34). Confiança não é acurácia.",
      "fieldKeys": [
        "intelligence.confidence"
      ]
    },
    {
      "term": "Tabela de preço",
      "code": "PRICE_TABLE",
      "definition": "Versão publicada e imutável de R$/m² e planos. Preço do lote = área × R$/m² da tabela vigente (preço de tabela, nunca promessa de valorização).",
      "fieldKeys": [
        "commercial.price",
        "commercial.pricePerM2",
        "commercial.priceTableVersion"
      ]
    },
    {
      "term": "Publicação",
      "code": "PUBLICATION",
      "definition": "Conjunto de versões (estática, análise, tabela) liberado para uso, com snapshot de qualidade.",
      "fieldKeys": []
    },
    {
      "term": "Finding",
      "code": "FINDING",
      "definition": "Registro de uma regra de qualidade violada (≠ incidente).",
      "fieldKeys": []
    },
    {
      "term": "Exceção de qualidade",
      "code": "QUALITY_EXCEPTION",
      "definition": "Decisão governada, com motivo, aprovação e expiração obrigatória.",
      "fieldKeys": []
    },
    {
      "term": "Completude do registro",
      "code": "RECORD_COMPLETENESS",
      "definition": "Para clientes: completude do registro, nunca 'qualidade do cliente'.",
      "fieldKeys": []
    }
  ],
