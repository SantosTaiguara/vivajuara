{
  "architectureVersion": "1.0",
  "effectiveFrom": "2026-10-11",
  "primaryStyle": "MODULAR_MONOLITH",
  "frontendStyle": "spa-pwa-map-centric (single-file build, global App namespace)",
  "apiVersion": "v1",
  "documentRefs": [
    "docs/ARCHITECTURE.md",
    "docs/REFERENCE_ARCHITECTURE_V1.md",
    "docs/MODULE_DEPENDENCY_MATRIX.md",
    "docs/ARCHITECTURE_FITNESS_FUNCTIONS.md",
    "docs/ARCHITECTURE_GAP_REPORT.md"
  ],
  "layers": {
    "kernel": {
      "description": "prelude: cria o objeto global App",
      "mayDependOn": [],
      "noDom": false
    },
    "config": {
      "description": "DevelopmentConfig e configuração de apresentação (dados, sem regra)",
      "mayDependOn": [
        "kernel",
        "shared",
        "domain"
      ],
      "noDom": true,
      "noStorage": true,
      "noNetwork": true,
      "mayNameRawFiles": true
    },
    "shared": {
      "description": "primitivas transversais sem regra de negócio (i18n, formatters, integridade)",
      "mayDependOn": [
        "kernel",
        "config"
      ],
      "noDom": true,
      "noStorage": true,
      "noNetwork": true
    },
    "domain": {
      "description": "modelo e regras puras (sem DOM, storage, rede ou relógio implícito)",
      "mayDependOn": [
        "kernel",
        "config",
        "shared",
        "domain"
      ],
      "noDom": true,
      "noStorage": true,
      "noNetwork": true
    },
    "application": {
      "description": "serviços de aplicação, view models, estado e orquestração",
      "mayDependOn": [
        "kernel",
        "config",
        "shared",
        "domain",
        "application",
        "infrastructure"
      ],
      "noDom": true,
      "noNetwork": true
    },
    "infrastructure": {
      "description": "acesso a dados, cache, carregamento, rede, storage, telemetria técnica (adaptadores de browser permitidos)",
      "mayDependOn": [
        "kernel",
        "config",
        "shared",
        "domain",
        "infrastructure"
      ],
      "noDom": false,
      "mayNameRawFiles": true
    },
    "presentation": {
      "description": "views (strings HTML) e renderer do mapa",
      "mayDependOn": [
        "kernel",
        "config",
        "shared",
        "domain",
        "application",
        "infrastructure",
        "presentation"
      ],
      "noStorage": true,
      "noNetwork": true,
      "noDomainMutation": true
    },
    "composition": {
      "description": "composition root do browser (presentation/app.js)",
      "mayDependOn": [
        "kernel",
        "config",
        "shared",
        "domain",
        "application",
        "infrastructure",
        "presentation",
        "governance"
      ],
      "noDomainMutation": true
    },
    "worker": {
      "description": "service worker (template); somente rede e cache",
      "mayDependOn": [],
      "mayNameRawFiles": true
    },
    "governance": {
      "description": "fitness functions e registros de preservação (tempo de teste/build)",
      "mayDependOn": [
        "kernel",
        "config",
        "shared",
        "domain",
        "application",
        "infrastructure",
        "presentation"
      ],
      "noDom": true,
      "noStorage": true,
      "noNetwork": true,
      "mayNameRawFiles": true
    }
  },
  "cycleExcludedLayers": [
    "presentation",
    "composition",
    "governance",
    "worker"
  ],
