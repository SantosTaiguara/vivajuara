    { "methodId": "down_payment_percent_of_price", "methodVersion": "1", "methodType": "FORMULA", "legacySourceId": "price-table-v1", "legacyMethods": ["price-table"], "formula": "downPaymentDefaultValue = price × downPaymentDefaultPercent / 100", "verifiable": true, "descriptionKey": "Entrada padrão = percentual × preço de tabela" },
