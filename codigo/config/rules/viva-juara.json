  {
   "id": "rule:viva-juara:NOISE@1.0.0",
   "organizationId": "house7",
   "ruleDefinitionId": "rule:viva-juara:NOISE",
   "version": "1.0.0",
   "sequence": 1,
   "lifecycleStatus": "PUBLISHED",
   "condition": {
    "type": "COMPARISON",
    "left": {
     "type": "METRIC",
     "metricId": "ANALYSIS_NOTE_QUIET"
    },
    "operator": "LT",
    "right": {
     "type": "CONFIG",
     "key": "maxQuietNote"
    }
   },
   "parameters": {
    "maxQuietNote": 5
   },
   "severityPolicy": {
    "type": "STATIC",
    "severity": "ATTENTION"
   },
   "unknownPolicy": {
    "behavior": "NO_ALERT",
    "reasonCode": "ALERT_INPUT_UNKNOWN_NOISE"
   },
   "messageTemplates": {
    "DEFAULT": [
     {
      "text": "exposição potencial a "
     },
     {
      "list": {
       "type": "METRIC",
       "metricId": "NOISE_SOURCES"
      },
      "separator": ", ",
      "item": [
       {
        "when": {
         "type": "COMPARISON",
         "left": {
          "type": "ITEM",
          "field": "kind"
         },
         "operator": "EQ",
         "right": {
          "type": "LITERAL",
          "value": "STREET_FLOW",
          "valueType": "ENUM"
         }
        },
        "then": [
         {
          "text": "fluxo "
         },
         {
          "value": {
           "type": "ITEM",
           "field": "level"
          },
          "format": "MAP",
          "map": {
           "VERY_LOW": "muito baixo",
           "LOW": "baixo",
           "MEDIUM": "médio",
           "HIGH": "alto",
           "VERY_HIGH": "muito alto"
          }
         },
         {
          "text": " na rua"
         }
        ],
        "else": [
         {
          "value": {
           "type": "ITEM",
           "field": "source"
          },
          "format": "MAP",
          "map": {
           "AVENUE": "Av. Porto Dourado",
           "GATE": "portaria",
           "CLUB": "clube",
           "PLAYGROUND": "playground",
           "SQUARE": "praça",
           "PARKING": "estacionamento",
           "TECHNICAL_AREA": "EEEB"
          }
         },
         {
          "text": " ("
         },
         {
          "value": {
           "type": "ITEM",
           "field": "distanceM"
          },
          "format": "FIXED_0"
         },
         {
          "text": " m)"
         }
        ]
       }
      ]
     }
    ]
   },
   "evidencePolicy": {
    "includeOperands": true,
    "includeDataVersions": true
   },
   "lifecyclePolicy": {
    "autoResolveWhenFalse": true,
    "reopenWhenTrue": true,
    "acknowledgeAllowed": true,
    "dismissAllowed": true,
    "snoozeAllowed": true
   },
