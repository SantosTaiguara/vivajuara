  {
   "id": "privacy",
   "fieldKey": "environmental.privacyScore",
   "label": "Privacidade",
   "version": "1.0",
   "requires": [
    "surroundings.rearClass",
    "geometry.isCorner",
    "geometry.hasTwoFronts",
    "mobility.estimatedTraffic",
    "location.distanceToSquareM",
    "location.distanceToPlaygroundM",
    "location.distanceToGateLinearM"
   ],
   "steps": [
    {
     "op": "FIXED_SCALE",
     "value": 6
    },
    {
     "op": "ENUM_DELTA",
     "input": "surroundings.rearClass",
     "map": {
      "GREEN_EXTERNAL": 3,
      "CONDO_GREEN": 3,
      "PERIMETER": 2,
      "COMMON_AREA": 1
     },
     "reason": "REAR_NEIGHBOR"
    },
    {
     "op": "BOOLEAN_DELTA",
     "input": "geometry.isCorner",
     "whenTrue": -2,
     "reason": "CORNER"
    },
    {
     "op": "BOOLEAN_DELTA",
     "input": "geometry.hasTwoFronts",
     "whenTrue": -1.5,
     "reason": "TWO_FRONTS"
    },
    {
     "op": "ENUM_DELTA",
     "input": "mobility.estimatedTraffic",
     "map": {
      "VERY_HIGH": -2,
      "HIGH": -1.5,
      "MEDIUM": -0.7
     },
     "reason": "STREET_FLOW"
    },
    {
     "op": "THRESHOLD",
     "inputMinOf": [
      "location.distanceToSquareM",
      "location.distanceToPlaygroundM"
     ],
     "bands": [
      {
       "lt": 30,
       "delta": -1
      }
     ],
     "reason": "NEAR_SQUARE_OR_PLAYGROUND"
    },
    {
     "op": "THRESHOLD",
     "input": "location.distanceToGateLinearM",
     "bands": [
      {
       "lt": 80,
       "delta": -1
      }
     ],
     "reason": "NEAR_GATE"
