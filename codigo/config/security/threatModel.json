 "threats": [
  {
   "threatId": "T-01",
   "assetId": "A-USER",
   "flows": [
    "login"
   ],
   "category": "Spoofing",
   "description": "Força bruta / credential stuffing no login ou em token de API",
   "attackSurface": "POST /auth/*, Authorization: Bearer",
   "prerequisites": [
    "endpoint público"
   ],
   "impact": "tomada de conta",
   "likelihood": "MEDIUM",
   "severity": "HIGH",
   "mitigations": [
    "IdP padrão (OIDC) — D50-4",
    "rate limit auth.login (5/min por IP+conta)",
    "tokens de 256 bits comparados em tempo constante",
    "MFA para OWNER_ADMIN e ações críticas",
    "mensagem genérica 'Credenciais inválidas'"
   ],
   "residualRisk": "sem IdP real ainda: só ADMIN_API_TOKEN e dev tokens (bloqueados em produção)"
  },
  {
   "threatId": "T-02",
   "assetId": "A-CUSTOMER",
   "flows": [
    "tenant_switch",
    "customer_data"
   ],
   "category": "Information Disclosure",
   "description": "BOLA/IDOR: usuário da Org A pede recurso da Org B trocando o id",
   "attackSurface": "GET /api/v1/... com ids previsíveis; X-Organization-Id",
   "prerequisites": [
    "conta válida em qualquer org"
   ],
   "impact": "vazamento entre tenants",
   "likelihood": "MEDIUM",
   "severity": "CRITICAL",
   "mitigations": [
    "tenancy.guard no backend antes do handler (deny by default)",
    "X-Organization-Id é seletor, nunca autoridade (membership revalidada)",
    "repositórios recebem tenantContext",
    "testes cross-tenant (security.test.js, tenancy.test.js)"
   ],
   "residualRisk": "RLS do Postgres não ativada (defesa em profundidade opcional)"
  },
  {
   "threatId": "T-03",
   "assetId": "A-CUSTOMER",
   "flows": [
    "customer_data",
    "browser_rendering"
   ],
   "category": "Tampering",
   "description": "XSS armazenado: nome/nota de cliente, título de documento, termo de busca, valores restaurados do localStorage renderizados via innerHTML",
   "attackSurface": "templates das views (innerHTML)",
   "prerequisites": [
    "gravar valor no storage/dado exibido"
   ],
   "impact": "execução de script na origem do painel",
   "likelihood": "MEDIUM",
   "severity": "HIGH",
   "mitigations": [
    "esc() em todo template (App.securityHardening.escapeHtml)",
    "scrubRestoredState() tipa o estado restaurado",
    "CSP sem 'unsafe-inline' para scripts (hash) — testada sem violações",
    "fuzz de renderização em security50.test.js"
   ],
   "residualRisk": "11 campos sem esc() em panels.js até o patch P1 ser aplicado (mitigado pelo scrub)"
  },
  {
