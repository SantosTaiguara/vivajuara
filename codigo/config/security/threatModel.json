   "impact": "acesso a projeção client-safe",
   "likelihood": "MEDIUM",
   "severity": "HIGH",
   "mitigations": [
    "token 256 bits, só HMAC armazenado (share.tokens.js)",
    "Referrer-Policy no-referrer",
    "Cache-Control no-store na rota share",
    "redactText() remove /s/<token> de logs/eventos",
    "rate limit share.validate"
   ],
   "residualRisk": "serviço de share do servidor ainda não implantado"
